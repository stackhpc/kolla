FROM {{ namespace }}/{{ image_prefix }}ironic-base:{{ tag }}
{% block labels %}
LABEL maintainer="{{ maintainer }}" name="{{ image_name }}"
{% endblock %}

{% block ironic_conductor_header %}{% endblock %}

{% import "macros.j2" as macros with context %}


{{ macros.enable_extra_repos(['docker-ce']) }}
{{ macros.kolla_enable_base_repos() }}

{% if base_package_type == 'rpm' %}
    {% set ironic_conductor_packages = [
        'docker-ce-cli',
        'dosfstools',
        'e2fsprogs',
        'fuse',
        'gdisk',
        'ipmitool',
        'mtools',
        'openssh-clients',
        'parted',
        'psmisc',
        'python3-systemd',
        'qemu-img',
        'systemd-udev',
        'util-linux',
        'xfsprogs',
        'xorriso',
        'zstd'
    ] %}
    {% if base_arch in ['x86_64'] %}
        {% set ironic_conductor_packages = ironic_conductor_packages + [
            'syslinux'
        ] %}
    {% endif %}
{% elif base_package_type == 'deb' %}
    {% set ironic_conductor_packages = [
        'bsdmainutils',
        'docker-ce-cli',
        'dosfstools',
        'e2fsprogs',
        'gdisk',
        'genisoimage',
        'ipmitool',
        'isolinux',
        'mtools',
        'openssh-client',
        'parted',
        'psmisc',
        'python3-systemd',
        'qemu-utils',
        'shellinabox',
        'syslinux-common',
        'udev',
        'xfsprogs',
        'zstd'
    ] %}
{% endif %}

{% set ironic_conductor_pip_packages = [
    'ironic-staging-drivers',
] %}

{% set ironic_conductor_plugins_pip_packages = [
'/plugins/*'
] %}

ADD plugins-archive /
RUN {{ macros.install_pip(ironic_conductor_pip_packages | customizable("pip_packages")) }} \
    && if [ "$(ls /plugins)" ]; then \
        {{ macros.install_pip(ironic_conductor_plugins_pip_packages) }}; \
    fi

{{ macros.install_packages(ironic_conductor_packages | customizable("packages")) }}

COPY ironic_conductor_sudoers /etc/sudoers.d/kolla_ironic_conductor_sudoers

RUN chmod 750 /etc/sudoers.d \
    && chmod 440 /etc/sudoers.d/kolla_ironic_conductor_sudoers

{{ macros.kolla_patch_sources() }}

{% block ironic_conductor_footer %}{% endblock %}
{% block footer %}{% endblock %}
{{ macros.kolla_cleanup_repos() }}

USER ironic
